@model RescheduleForm
@{ ViewData["Title"] = "Update appointment"; }
<div class="page-header"><div><a asp-action="Details" asp-route-id="@Model.Id" class="small"><i class="bi bi-arrow-left"></i> Appointment</a><h1>Update appointment time</h1>
    <p class="subtitle">@Model.Original?.Client?.FullName · currently @Model.Original?.StartTime.ToString("ddd dd MMM HH:mm")</p></div></div>
<div class="card" style="max-width:640px"><div class="card-body">
    <form asp-action="Reschedule" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" step="900" />
                <span asp-validation-for="StartTime" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <select asp-for="DurationMinutes" class="form-select">@foreach (var m in new[] { 30, 45, 60, 90, 120 }) { <option value="@m">@m minutes</option> }</select>
            </div>
            <div class="col-12"><label asp-for="TrainerNotes" class="form-label"></label><textarea asp-for="TrainerNotes" rows="2" class="form-control"></textarea></div>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Save and notify client</button>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
