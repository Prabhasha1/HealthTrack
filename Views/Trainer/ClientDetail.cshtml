@model ClientDetailViewModel
@{ ViewData["Title"] = Model.Client.FullName; var c = Model.Client; }
<div class="page-header">
    <div>
        <a asp-action="Dashboard" class="small"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <h1>@c.FullName</h1>
        <p class="subtitle">@(c.Age.HasValue ? c.Age + " yrs · " : "")@(c.Gender?.ToString() ?? "") @(c.HeightCm.HasValue ? " · " + c.HeightCm + " cm" : "") @(c.FitnessGoal != null ? " · Goal: " + c.FitnessGoal : "")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <partial name="_PeriodPicker" model="Model.Progress.Days" />
        <a asp-controller="WorkoutPlans" asp-action="Create" asp-route-clientId="@c.Id" class="btn btn-primary btn-sm"><i class="bi bi-clipboard2-plus"></i> Workout plan</a>
        <a asp-controller="DietPlans" asp-action="Create" asp-route-clientId="@c.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-basket"></i> Diet plan</a>
    </div>
</div>

<partial name="_ProgressCharts" model="Model.Progress" />

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Plans</div>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.WorkoutPlans)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-clipboard2-pulse text-primary"></i> <a asp-controller="WorkoutPlans" asp-action="Details" asp-route-id="@p.Id">@p.Title</a>
                            <small class="text-muted d-block">@p.Exercises.Count exercises · by @p.Trainer?.FullName</small></span>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") align-self-center">@(p.IsActive ? "Active" : "Inactive")</span>
                    </li>
                }
                @foreach (var p in Model.DietPlans)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-basket text-primary"></i> <a asp-controller="DietPlans" asp-action="Details" asp-route-id="@p.Id">@p.Title</a>
                            <small class="text-muted d-block">@p.DailyCalorieTarget kcal/day · by @p.Trainer?.FullName</small></span>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") align-self-center">@(p.IsActive ? "Active" : "Inactive")</span>
                    </li>
                }
                @if (Model.WorkoutPlans.Count + Model.DietPlans.Count == 0) { <li class="list-group-item text-muted">No plans yet.</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Give feedback</div>
            <div class="card-body">
                <form asp-action="GiveFeedback" method="post">
                    <input type="hidden" asp-for="NewFeedback.ClientId" />
                    <textarea asp-for="NewFeedback.Message" class="form-control mb-2" rows="3" placeholder="What's going well, and what to focus on next…"></textarea>
                    <span asp-validation-for="NewFeedback.Message" class="text-danger small"></span>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="NewFeedback.Rating" class="form-select form-select-sm" style="max-width:160px">
                            <option value="">No rating</option>
                            @for (int i = 5; i >= 1; i--) { <option value="@i">@(new string('★', i))</option> }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-send"></i> Send</button>
                    </div>
                </form>
                <hr />
                @foreach (var f in Model.Feedback.Take(4))
                {
                    <div class="feedback-quote mb-2 small">@f.Message<br /><span class="text-muted">— @f.Trainer?.FullName, @f.CreatedAt.ToString("dd MMM")</span></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Recent workouts</div>
            <table class="table table-sm mb-0">
                <thead><tr><th>Date</th><th>Exercise</th><th>Min</th><th>kcal</th></tr></thead>
                <tbody>
                @foreach (var w in Model.RecentWorkouts)
                {
                    <tr><td>@w.Date.ToString("dd MMM")</td><td>@w.ExerciseName</td><td>@w.DurationMinutes</td><td>@w.CaloriesBurned</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Recent meals</div>
            <table class="table table-sm mb-0">
                <thead><tr><th>Date</th><th>Meal</th><th>Description</th><th>kcal</th></tr></thead>
                <tbody>
                @foreach (var m in Model.RecentMeals)
                {
                    <tr><td>@m.Date.ToString("dd MMM")</td><td>@Display.Words(m.MealType)</td><td>@m.Description</td><td>@m.Calories</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
