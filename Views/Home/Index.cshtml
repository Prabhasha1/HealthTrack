@{ ViewData["Title"] = "Welcome"; }
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1>Track your health. Reach your goals.</h1>
                <p class="lead mt-3 mb-4">HealthTrack brings your workouts, meals, health measurements and appointments with
                    trainers and health professionals together in one secure place.</p>
                <a class="btn btn-light btn-lg me-2" asp-controller="Account" asp-action="Register">Get started - it's free</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="card text-dark p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="stat-icon ic-teal"><i class="bi bi-graph-down-arrow"></i></span>
                        <div><div class="text-muted small">Weight, last 60 days</div><div class="fs-4 fw-bold">-4.6 kg</div></div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="stat-icon ic-orange"><i class="bi bi-fire"></i></span>
                        <div><div class="text-muted small">Calories burned this week</div><div class="fs-4 fw-bold">1,840 kcal</div></div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="stat-icon ic-blue"><i class="bi bi-calendar-check"></i></span>
                        <div><div class="text-muted small">Next appointment</div><div class="fs-6 fw-bold">Nutrition consultation, Tue 10:00</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="container py-5">
    <div class="row g-4 text-center">
        <div class="col-md-3 feature"><i class="bi bi-clipboard2-pulse"></i><h5 class="mt-2">Personal plans</h5><p class="text-muted">Workout and diet plans built for you by your trainer.</p></div>
        <div class="col-md-3 feature"><i class="bi bi-graph-up-arrow"></i><h5 class="mt-2">Progress analytics</h5><p class="text-muted">See trends in weight, BMI and calories over time.</p></div>
        <div class="col-md-3 feature"><i class="bi bi-calendar2-week"></i><h5 class="mt-2">Appointments</h5><p class="text-muted">Book consultations with trainers and health professionals.</p></div>
        <div class="col-md-3 feature"><i class="bi bi-shield-lock"></i><h5 class="mt-2">Private &amp; secure</h5><p class="text-muted">Encrypted health notes, role-based access and audit logging.</p></div>
    </div>
</section>
