@model List<WorkoutLog>
@{ ViewData["Title"] = "Workout log"; DateTime from = ViewBag.From, to = ViewBag.To; }
<div class="page-header">
    <div><h1>Workout log</h1><p class="subtitle">@Model.Count workouts · @Model.Sum(w => w.DurationMinutes) min · @Model.Sum(w => w.CaloriesBurned).ToString("N0") kcal burned</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Log workout</a>
</div>
<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto"><label class="form-label small mb-0">From</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-auto"><label class="form-label small mb-0">To</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Show</button></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Date</th><th>Exercise</th><th>Plan</th><th>Duration</th><th>Intensity</th><th>Calories</th><th>Notes</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="8" class="empty-state"><i class="bi bi-activity"></i>No workouts in this period.</td></tr> }
            @foreach (var w in Model)
            {
                <tr>
                    <td class="text-nowrap">@w.Date.ToString("ddd dd MMM")</td>
                    <td><strong>@w.ExerciseName</strong></td>
                    <td class="small text-muted">@w.WorkoutPlan?.Title</td>
                    <td>@w.DurationMinutes min</td>
                    <td>@w.Intensity</td>
                    <td>@w.CaloriesBurned kcal</td>
                    <td class="small text-muted">@w.Notes</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@w.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" data-confirm="Delete this workout?"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
