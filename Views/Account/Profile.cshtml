@model ProfileViewModel
@{ ViewData["Title"] = "Profile & privacy"; }
<div class="page-header">
    <div><h1>Profile &amp; privacy</h1><p class="subtitle">Keep your details up to date and control your reminders.</p></div>
    <a asp-action="ChangePassword" class="btn btn-outline-primary"><i class="bi bi-key"></i> Change password</a>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Profile" method="post" id="profileForm" novalidate>
        <div class="card">
            <div class="card-header">Personal details</div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()"><option value="">--</option></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HeightCm" class="form-label"></label>
                        <input asp-for="HeightCm" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="HeightCm" class="text-danger small"></span>
                    </div>
                    @if (Model.IsTrainer)
                    {
                        <div class="col-12">
                            <label asp-for="Specialization" class="form-label"></label>
                            <input asp-for="Specialization" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label"></label>
                            <textarea asp-for="Bio" rows="3" class="form-control"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <label asp-for="FitnessGoal" class="form-label"></label>
                            <input asp-for="FitnessGoal" class="form-control" />
                        </div>
                        <div class="col-12 small text-muted">
                            Assigned trainer: <strong>@(Model.AssignedTrainerName ?? "not assigned yet")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
        </form>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">Reminders</div>
            <div class="card-body">
                <div class="form-check form-switch mb-2">
                    <input asp-for="WorkoutRemindersEnabled" class="form-check-input" role="switch" form="profileForm" />
                    <label asp-for="WorkoutRemindersEnabled" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="MealRemindersEnabled" class="form-check-input" role="switch" form="profileForm" />
                    <label asp-for="MealRemindersEnabled" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="AppointmentRemindersEnabled" class="form-check-input" role="switch" form="profileForm" />
                    <label asp-for="AppointmentRemindersEnabled" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <button type="submit" form="profileForm" class="btn btn-primary w-100 mb-4"><i class="bi bi-save"></i> Save profile</button>
        <div class="card">
            <div class="card-header">Your data</div>
            <div class="card-body small">
                <p>Download a copy of everything HealthTrack stores about you (JSON format).</p>
                <form asp-action="ExportMyData" method="post">
                    <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-download"></i> Download my data</button>
                </form>
                <p class="mt-3 mb-0 text-muted">Read the <a asp-controller="Home" asp-action="Privacy">privacy notice</a>.</p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
