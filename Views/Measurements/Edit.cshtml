@model HealthMeasurement
@{ bool isNew = Model.Id == 0; ViewData["Title"] = isNew ? "Add measurement" : "Edit measurement"; }
<div class="page-header"><div><a asp-action="Index" class="small"><i class="bi bi-arrow-left"></i> Measurements</a><h1>@ViewData["Title"]</h1></div></div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="Date" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="WeightKg" class="form-label">Weight (kg)</label><input asp-for="WeightKg" class="form-control" step="0.1" id="WeightKg" /><span asp-validation-for="WeightKg" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="HeightCm" class="form-label">Height (cm)</label><input asp-for="HeightCm" class="form-control" step="0.1" id="HeightCm" /><span asp-validation-for="HeightCm" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="BodyFatPercent" class="form-label">Body fat (%)</label><input asp-for="BodyFatPercent" class="form-control" step="0.1" /><span asp-validation-for="BodyFatPercent" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="RestingHeartRate" class="form-label">Resting heart rate (bpm)</label><input asp-for="RestingHeartRate" class="form-control" /><span asp-validation-for="RestingHeartRate" class="text-danger small"></span></div>
                    <div class="col-md-2"><label asp-for="SystolicBp" class="form-label">Systolic</label><input asp-for="SystolicBp" class="form-control" /><span asp-validation-for="SystolicBp" class="text-danger small"></span></div>
                    <div class="col-md-2"><label asp-for="DiastolicBp" class="form-label">Diastolic</label><input asp-for="DiastolicBp" class="form-control" /><span asp-validation-for="DiastolicBp" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="Notes" class="form-label">Notes <i class="bi bi-lock-fill text-muted" title="Encrypted in the database"></i></label><textarea asp-for="Notes" rows="2" class="form-control"></textarea>
                        <div class="form-text">Notes are encrypted before they are stored.</div></div>
                </div>
                <button type="submit" class="btn btn-primary mt-4"><i class="bi bi-save"></i> Save</button>
                <a asp-action="Index" class="btn btn-link mt-4">Cancel</a>
            </form>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card stat-card text-center">
            <span class="label">BMI preview</span>
            <div class="value" id="bmiValue">–</div>
            <div><span class="badge bg-secondary" id="bmiCategory">enter weight &amp; height</span></div>
            <div class="hint mt-2">Underweight &lt; 18.5 · Normal 18.5–24.9 · Overweight 25–29.9 · Obese ≥ 30</div>
        </div>
    </div>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    // Live BMI preview - mirrors HealthCalculator.CalculateBmi on the server.
    function updateBmi() {
        const w = parseFloat(document.getElementById('WeightKg').value);
        const h = parseFloat(document.getElementById('HeightCm').value) / 100;
        const out = document.getElementById('bmiValue'), cat = document.getElementById('bmiCategory');
        if (!(w > 0 && h > 0)) { out.textContent = '–'; return; }
        const bmi = Math.round(w / (h * h) * 10) / 10;
        out.textContent = bmi.toFixed(1);
        const [label, cls] = bmi < 18.5 ? ['Underweight', 'bg-info text-dark'] : bmi < 25 ? ['Normal', 'bg-success']
                           : bmi < 30 ? ['Overweight', 'bg-warning text-dark'] : ['Obese', 'bg-danger'];
        cat.textContent = label; cat.className = 'badge ' + cls;
    }
    ['WeightKg', 'HeightCm'].forEach(id => document.getElementById(id).addEventListener('input', updateBmi));
    updateBmi();
</script>
}
