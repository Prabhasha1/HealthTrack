@model List<HealthMeasurement>
@{ ViewData["Title"] = "Measurements"; }
<div class="page-header">
    <div><h1>Health measurements</h1><p class="subtitle">BMI is calculated automatically from your weight and height.</p></div>
    <div class="d-flex gap-2">
        <a asp-controller="Progress" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-graph-up"></i> Charts</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add measurement</a>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Date</th><th>Weight</th><th>BMI</th><th>Body fat</th><th>Resting HR</th><th>Blood pressure</th><th>Notes</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="8" class="empty-state"><i class="bi bi-rulers"></i>No measurements recorded yet.</td></tr> }
            @foreach (var m in Model)
            {
                <tr>
                    <td class="text-nowrap">@m.Date.ToString("dd MMM yyyy")</td>
                    <td><strong>@m.WeightKg.ToString("0.0")</strong> kg</td>
                    <td><span class="badge @HealthCalculator.BmiBadgeClass(m.Bmi)">@m.Bmi.ToString("0.0")</span></td>
                    <td>@(m.BodyFatPercent.HasValue ? m.BodyFatPercent.Value.ToString("0.0") + " %" : "–")</td>
                    <td>@(m.RestingHeartRate.HasValue ? m.RestingHeartRate + " bpm" : "–")</td>
                    <td>@(m.SystolicBp.HasValue ? $"{m.SystolicBp}/{m.DiastolicBp}" : "–")</td>
                    <td class="small text-muted">@if (!string.IsNullOrEmpty(m.Notes)) { <i class="bi bi-lock-fill" title="Stored encrypted"></i> @m.Notes }</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" data-confirm="Delete this measurement?"><i class="bi bi-trash"></i></button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
