@model UserListViewModel
@{ ViewData["Title"] = "Users"; }
<div class="page-header">
    <div><h1>Users</h1><p class="subtitle">Manage accounts, roles and trainer assignments.</p></div>
    <div class="d-flex gap-2">
        <a asp-action="CreateUser" asp-route-role="Trainer" class="btn btn-primary"><i class="bi bi-person-plus"></i> New user</a>
    </div>
</div>
<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2">
            <div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="Search name or e-mail" /></div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">All roles</option>
                    @foreach (var r in Roles.All) { <option value="@r" selected="@(Model.RoleFilter == r)">@r</option> }
                </select>
            </div>
            <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Filter</button></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Role</th><th>Trainer / speciality</th><th>Last login</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td><strong>@u.FullName</strong><br /><small class="text-muted">@u.Email</small></td>
                    <td><span class="badge @(u.Role == Roles.Admin ? "bg-dark" : u.Role == Roles.Trainer ? "bg-primary" : "bg-light text-dark border")">@u.Role</span></td>
                    <td class="small">@(u.Role == Roles.Client ? (u.AssignedTrainerName ?? "— unassigned —") : u.Specialization)</td>
                    <td class="small">@Display.Ago(u.LastLoginAt)</td>
                    <td>
                        @if (!u.IsActive) { <span class="badge bg-secondary">Deactivated</span> }
                        else if (u.IsLockedOut) { <span class="badge bg-danger">Locked</span> }
                        else { <span class="badge bg-success">Active</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        @if (u.Role == Roles.Client)
                        {
                            <a asp-action="AssignTrainer" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Assign trainer"><i class="bi bi-person-check"></i></a>
                            <a asp-controller="Progress" asp-action="Index" asp-route-clientId="@u.Id" class="btn btn-sm btn-outline-primary" title="Progress"><i class="bi bi-graph-up"></i></a>
                        }
                        @if (u.IsLockedOut)
                        {
                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning" title="Unlock"><i class="bi bi-unlock"></i></button></form>
                        }
                        <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")"
                                    data-confirm="@(u.IsActive ? "Deactivate" : "Activate") @u.FullName?">
                                <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check-fill")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Users.Count == 0) { <tr><td colspan="6" class="empty-state">No users match the filter.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
