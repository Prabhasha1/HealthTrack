@model AdminDashboardViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Admin dashboard"; }
<div class="page-header">
    <div><h1>System overview</h1><p class="subtitle">User activity, system usage and trainer assignments.</p></div>
    <div class="d-flex gap-2">
        <form asp-action="RunReminders" method="post"><button class="btn btn-outline-primary"><i class="bi bi-bell"></i> Run reminder check</button></form>
        <a asp-action="CreateUser" asp-route-role="Trainer" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add trainer</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="label">Clients</span><span class="stat-icon ic-teal"><i class="bi bi-people"></i></span></div>
        <div class="value">@Model.TotalClients</div><div class="hint">+@Model.NewUsersLast30Days in 30 days · @Model.UnassignedClients unassigned</div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="label">Trainers</span><span class="stat-icon ic-blue"><i class="bi bi-person-badge"></i></span></div>
        <div class="value">@Model.TotalTrainers</div><div class="hint">@Model.TotalAdmins administrator(s)</div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="label">Active users (7d)</span><span class="stat-icon ic-orange"><i class="bi bi-activity"></i></span></div>
        <div class="value">@Model.ActiveUsersLast7Days</div><div class="hint">@Model.LogsToday entries logged today</div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="label">Pending appointments</span><span class="stat-icon ic-purple"><i class="bi bi-calendar-event"></i></span></div>
        <div class="value">@Model.PendingAppointments</div><div class="hint">awaiting trainer approval</div></div></div>
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="card mb-4">
            <div class="card-header">System usage – last 14 days</div>
            <div class="card-body"><div class="chart-box"><canvas id="usageChart"></canvas></div></div>
        </div>
        <div class="card">
            <div class="card-header">Trainer assignments <a asp-action="Users" asp-route-role="Client" class="small fw-normal">Assign clients</a></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Trainer</th><th>Specialisation</th><th>Clients</th><th>Active plans</th><th>Upcoming appts</th></tr></thead>
                    <tbody>
                    @{ int maxClients = Math.Max(1, Model.TrainerAssignments.Select(t => t.ClientCount).DefaultIfEmpty(0).Max()); }
                    @foreach (var t in Model.TrainerAssignments)
                    {
                        <tr>
                            <td><strong>@t.TrainerName</strong></td>
                            <td class="text-muted">@t.Specialization</td>
                            <td style="min-width:140px">
                                <div class="d-flex align-items-center gap-2">@t.ClientCount
                                    <div class="progress progress-thin flex-grow-1"><div class="progress-bar" style="width:@(100 * t.ClientCount / maxClients)%"></div></div>
                                </div>
                            </td>
                            <td>@t.ActivePlans</td>
                            <td>@t.UpcomingAppointments</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card mb-4">
            <div class="card-header">Appointments by status</div>
            <div class="card-body"><div class="chart-box sm"><canvas id="statusChart"></canvas></div></div>
        </div>
        <div class="card">
            <div class="card-header">Recent activity <a asp-action="ActivityLog" class="small fw-normal">Audit log</a></div>
            <ul class="list-group list-group-flush small">
                @foreach (var a in Model.RecentActivity)
                {
                    <li class="list-group-item d-flex justify-content-between gap-2">
                        <span><strong>@a.Action</strong> · @(a.User?.FullName ?? "system")</span>
                        <span class="text-muted text-nowrap">@Display.Ago(a.Timestamp)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
@section Scripts {
<script>
    htChart('usageChart', 'line', @Html.Raw(JsonSerializer.Serialize(Model.ActivityDays)), [
        { label: 'Log entries', data: @Html.Raw(JsonSerializer.Serialize(Model.LogEntriesPerDay)), borderColor: HT.teal, backgroundColor: HT.tealFill, fill: true, tension: .3 },
        { label: 'Logins', data: @Html.Raw(JsonSerializer.Serialize(Model.LoginsPerDay)), borderColor: HT.orange, tension: .3 }
    ], { scales: { x: { grid: { display: false } }, y: { beginAtZero: true, ticks: { precision: 0 } } } });
    htChart('statusChart', 'doughnut', @Html.Raw(JsonSerializer.Serialize(Model.AppointmentsByStatus.Keys)), [{
        data: @Html.Raw(JsonSerializer.Serialize(Model.AppointmentsByStatus.Values)),
        backgroundColor: ['#f59e0b', '#16a34a', '#0ea5e9', '#64748b', '#cbd5e1', '#dc2626'], borderWidth: 0
    }], { plugins: { legend: { position: 'right' } }, cutout: '62%' });
</script>
}
