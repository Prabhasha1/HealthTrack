@model DietPlan
@{
    ViewData["Title"] = Model.Title;
    bool owner = Model.TrainerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int planned = Model.Meals.Sum(m => m.Calories);
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left"></i> Diet plans</a>
        <h1>@Model.Title <span class="badge fs-6 align-middle @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></h1>
        <p class="subtitle">For <strong>@Model.Client?.FullName</strong> · by @Model.Trainer?.FullName · from @Model.StartDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> Print</button>
        @if (owner) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a> }
        @if (owner || User.IsInRole(Roles.Admin))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger" data-confirm="Delete this diet plan?"><i class="bi bi-trash"></i></button></form>
        }
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Daily schedule</div>
            <ul class="list-group list-group-flush">
                @foreach (var m in Model.Meals.OrderBy(m => m.Time))
                {
                    <li class="list-group-item d-flex gap-3 align-items-center">
                        <span class="day-chip">@m.Time.ToString(@"hh\:mm")</span>
                        <div class="flex-grow-1"><strong>@Display.Words(m.MealType)</strong><div class="text-muted small">@m.Description</div></div>
                        <span class="fw-semibold">@m.Calories kcal</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card stat-card mb-4">
            <span class="label">Daily calorie target</span>
            <div class="value">@Model.DailyCalorieTarget kcal</div>
            <div class="hint">Meals in plan add up to @planned kcal</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card"><div class="card-header">Guidance</div><div class="card-body small">@Model.Description</div></div>
        }
    </div>
</div>
