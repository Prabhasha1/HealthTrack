@{
    int code = ViewBag.Code ?? 0;
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
    string message = code switch
    {
        404 => "The page you were looking for does not exist or has been moved.",
        403 => "You do not have permission to view this page.",
        _ => "The request could not be completed."
    };
}
<div class="container py-5 text-center">
    <div class="display-4 fw-bold text-primary">@code</div>
    <h1 class="h4 mt-2">@ViewData["Title"]</h1>
    <p class="text-muted">@message</p>
    <a href="/" class="btn btn-primary">Back to HealthTrack</a>
</div>
