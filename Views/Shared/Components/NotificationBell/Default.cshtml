@model List<Notification>
@{ int unread = (int)ViewBag.Unread; }
<div class="dropdown">
    <button class="btn btn-light position-relative" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i class="bi bi-bell fs-5"></i>
        <span id="bell-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(unread == 0 ? "d-none" : "")">@unread</span>
    </button>
    <div class="dropdown-menu dropdown-menu-end p-0 bell-menu">
        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
            <strong>Notifications</strong>
            <a asp-controller="Notifications" asp-action="Index" class="small">View all</a>
        </div>
        @if (Model.Count == 0)
        {
            <div class="px-3 py-4 text-center text-muted small">You're all caught up.</div>
        }
        @foreach (var n in Model)
        {
            <form asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id" method="post">
                <button type="submit" class="dropdown-item bell-item @(n.IsRead ? "" : "unread")">
                    <i class="bi @NotificationIcon.For(n.Type)"></i>
                    <span>
                        <strong class="d-block">@n.Title</strong>
                        <span class="text-wrap small text-muted d-block">@n.Message</span>
                        <small class="text-muted">@n.CreatedAt.ToString("dd MMM HH:mm")</small>
                    </span>
                </button>
            </form>
        }
    </div>
</div>
