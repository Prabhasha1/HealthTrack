@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="container py-5 text-center">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size:3rem"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary">Back to HealthTrack</a>
</div>
