@model WorkoutPlan
@{
    ViewData["Title"] = Model.Title;
    bool owner = Model.TrainerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var byDay = Model.Exercises.GroupBy(e => e.Day).OrderBy(g => HealthTrack.Controllers.WorkoutPlansController.DayIndex(g.Key));
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left"></i> Workout plans</a>
        <h1>@Model.Title <span class="badge fs-6 align-middle @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></h1>
        <p class="subtitle">For <strong>@Model.Client?.FullName</strong> · by @Model.Trainer?.FullName · @Model.StartDate.ToString("dd MMM yyyy")@(Model.EndDate.HasValue ? " – " + Model.EndDate.Value.ToString("dd MMM yyyy") : "")</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> Print</button>
        @if (owner) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a> }
        @if (owner || User.IsInRole(Roles.Admin))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button class="btn btn-outline-danger" data-confirm="Delete this workout plan?"><i class="bi bi-trash"></i></button>
            </form>
        }
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.Description) || Model.Goal != null)
{
    <div class="card mb-4"><div class="card-body">
        @if (Model.Goal != null) { <div class="mb-1"><strong>Goal:</strong> @Model.Goal</div> }
        <div class="text-muted">@Model.Description</div>
    </div></div>
}
<div class="row g-4">
@foreach (var day in byDay)
{
    bool today = day.Key == DateTime.Today.DayOfWeek;
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 @(today ? "border border-2 border-success" : "")">
            <div class="card-header">@day.Key @if (today) { <span class="badge bg-success">Today</span> }</div>
            <ul class="list-group list-group-flush">
                @foreach (var e in day)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@e.Name</strong>
                            <span class="badge @(e.Intensity == Intensity.High ? "bg-danger" : e.Intensity == Intensity.Moderate ? "bg-warning text-dark" : "bg-info text-dark")">@e.Intensity</span>
                        </div>
                        <small class="text-muted">@(e.Sets > 0 ? $"{e.Sets} sets × {e.Reps} reps · " : "")@e.DurationMinutes min</small>
                        @if (!string.IsNullOrEmpty(e.Notes)) { <div class="small fst-italic">@e.Notes</div> }
                        @if (User.IsInRole(Roles.Client))
                        {
                            <a asp-controller="WorkoutLogs" asp-action="Create" asp-route-exercise="@e.Name" asp-route-minutes="@e.DurationMinutes" asp-route-intensity="@e.Intensity" class="small no-print">Log this</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
</div>
