@model List<WorkoutPlan>
@{ ViewData["Title"] = "Workout plans"; bool trainer = User.IsInRole(Roles.Trainer); }
<div class="page-header">
    <div><h1>Workout plans</h1><p class="subtitle">@(trainer ? "Plans you have created for your clients." : User.IsInRole(Roles.Admin) ? "All workout plans in the system." : "Your personalised routines.")</p></div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(Roles.Admin)) { <a asp-controller="DietPlans" asp-action="Index" class="btn btn-outline-primary">Diet plans</a> }
        @if (trainer) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New plan</a> }
    </div>
</div>
@if (Model.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-clipboard2"></i>No workout plans yet.</div></div>
}
<div class="row g-4">
@foreach (var p in Model)
{
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 @(p.IsActive ? "" : "opacity-75")">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span>
                    <small class="text-muted">@p.StartDate.ToString("dd MMM")@(p.EndDate.HasValue ? " – " + p.EndDate.Value.ToString("dd MMM yyyy") : " onwards")</small>
                </div>
                <h5 class="mb-1"><a asp-action="Details" asp-route-id="@p.Id" class="text-reset text-decoration-none">@p.Title</a></h5>
                <p class="small text-muted mb-2">@(trainer ? "Client: " + p.Client?.FullName : "Trainer: " + p.Trainer?.FullName)@(p.Goal != null ? " · " + p.Goal : "")</p>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var d in p.Exercises.Select(e => e.Day).Distinct().OrderBy(d => HealthTrack.Controllers.WorkoutPlansController.DayIndex(d)))
                    {
                        <span class="day-chip">@d.ToString().Substring(0, 3)</span>
                    }
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3 d-flex gap-2">
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Open</a>
                @if (trainer) { <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a> }
                <span class="ms-auto small text-muted align-self-center">@p.Exercises.Count exercises</span>
            </div>
        </div>
    </div>
}
</div>
