@model WorkoutPlanForm
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New workout plan" : "Edit workout plan";
    var days = Enum.GetValues<DayOfWeek>().OrderBy(d => HealthTrack.Controllers.WorkoutPlansController.DayIndex(d)).ToList();
}
<div class="page-header"><div><a asp-action="Index" class="small"><i class="bi bi-arrow-left"></i> Workout plans</a><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="card mb-4">
        <div class="card-header">Plan details</div>
        <div class="card-body row g-3">
            <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
            <div class="col-md-6">
                <label asp-for="ClientId" class="form-label"></label>
                <select asp-for="ClientId" asp-items="Model.ClientOptions" class="form-select"><option value="">-- choose client --</option></select>
                <span asp-validation-for="ClientId" class="text-danger small"></span>
            </div>
            <div class="col-md-4"><label asp-for="Goal" class="form-label"></label><input asp-for="Goal" class="form-control" placeholder="e.g. Weight loss" /></div>
            <div class="col-md-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
            <div class="col-md-2 d-flex align-items-end"><div class="form-check form-switch mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="2" class="form-control"></textarea></div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">Exercises
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-row="exerciseRows" data-template="exerciseTemplate"><i class="bi bi-plus"></i> Add exercise</button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 row-form">
                <thead><tr><th style="min-width:180px">Exercise</th><th>Day</th><th style="width:80px">Sets</th><th style="width:80px">Reps</th><th style="width:90px">Minutes</th><th>Intensity</th><th>Notes</th><th></th></tr></thead>
                <tbody id="exerciseRows">
                @for (int i = 0; i < Model.Exercises.Count; i++)
                {
                    <tr>
                        <td><input asp-for="Exercises[i].Name" class="form-control" /></td>
                        <td><select asp-for="Exercises[i].Day" class="form-select">@foreach (var d in days) { <option value="@d" selected="@(Model.Exercises[i].Day == d)">@d</option> }</select></td>
                        <td><input asp-for="Exercises[i].Sets" class="form-control" min="0" /></td>
                        <td><input asp-for="Exercises[i].Reps" class="form-control" min="0" /></td>
                        <td><input asp-for="Exercises[i].DurationMinutes" class="form-control" min="0" /></td>
                        <td><select asp-for="Exercises[i].Intensity" asp-items="Html.GetEnumSelectList<Intensity>()" class="form-select"></select></td>
                        <td><input asp-for="Exercises[i].Notes" class="form-control" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row title="Remove"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save plan</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

<template id="exerciseTemplate">
    <tr>
        <td><input name="Exercises[__i__].Name" class="form-control" maxlength="100" /></td>
        <td><select name="Exercises[__i__].Day" class="form-select">@foreach (var d in days) { <option value="@d">@d</option> }</select></td>
        <td><input name="Exercises[__i__].Sets" type="number" value="0" min="0" class="form-control" /></td>
        <td><input name="Exercises[__i__].Reps" type="number" value="0" min="0" class="form-control" /></td>
        <td><input name="Exercises[__i__].DurationMinutes" type="number" value="30" min="0" class="form-control" /></td>
        <td><select name="Exercises[__i__].Intensity" class="form-select">@foreach (var x in Enum.GetValues<Intensity>()) { <option value="@x" selected="@(x == Intensity.Moderate)">@x</option> }</select></td>
        <td><input name="Exercises[__i__].Notes" class="form-control" maxlength="250" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row title="Remove"><i class="bi bi-x-lg"></i></button></td>
    </tr>
</template>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
